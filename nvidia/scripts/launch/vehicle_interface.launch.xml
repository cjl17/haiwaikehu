<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <include file="$(find-pkg-share tier4_vehicle_launch)/launch/vehicle.launch.xml">
    <arg name="vehicle_model" value="robobus"/>
    <arg name="sensor_model" value="robobus_sensor_kit"/>
    <arg name="vehicle_id" value="$(env VEHICLE_ID default)"/>
    <arg name="launch_vehicle_interface" value="true"/>
    <arg name="config_dir" value="$(env HOME)/pix/parameter/sensor_kit/$(var sensor_model)_description/extrinsic_parameters"/>
  </include>
</launch>
