<launch>
  <arg name="scripts_root_path" />
  <arg name="map_path" />
  <arg name="vehicle_model" />
  <arg name="sensor_model" />
  <arg name="use_pointcloud_container" />
  <arg name="use_perception_container" />
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="launch_sensing" />
  <arg name="launch_sensing_driver" />
  <arg name="launch_perception" />
  <arg name="launch_map" />
  <arg name="launch_localization" />
  <arg name="launch_vehicle" />
  <arg name="launch_control" />
  <arg name="launch_system" />
  <arg name="launch_system_monitor" />
  <arg name="launch_planning" />
  <arg name="launch_api" />
  <arg name="rviz" />
  <arg name="rviz_respawn" />
  <arg name="use_perception_detection"/>
  <arg name="use_traffic_light_recognition"/>
  <arg name="launch_detection"/>
  <arg name="use_deeplearning_model"/>
  <arg name="use_non_deeplearning_model"/>
  <arg name="launch_tracking"/>
  <arg name="launch_prediction"/>
  <!-- 自动驾驶系统 -->
  <include file="$(find-pkg-share autoware_launch)/launch/autoware.launch.xml" >
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="use_pointcloud_container" value="$(var use_pointcloud_container)" />
    <arg name="use_perception_container" value="$(var use_perception_container)" />
    <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)" />
    <arg name="launch_sensing" value="$(var launch_sensing)" />
    <arg name="launch_sensing_driver" value="$(var launch_sensing_driver)" />
    <arg name="launch_perception" value="$(var launch_perception)" />
    <arg name="launch_detection" value="$(var launch_detection)"/>
    <arg name="use_deeplearning_model" value="$(var use_deeplearning_model)"/>
    <arg name="use_non_deeplearning_model" value="$(var use_non_deeplearning_model)"/>
    <arg name="launch_tracking" value="$(var launch_tracking)" />
    <arg name="launch_prediction" value="$(var launch_prediction)" />
    <arg name="launch_map" value="$(var launch_map)" />
    <arg name="launch_localization" value="$(var launch_localization)" />
    <arg name="launch_vehicle" value="$(var launch_vehicle)" />
    <arg name="launch_control" value="$(var launch_control)" />
    <arg name="launch_system" value="$(var launch_system)" />
    <arg name="launch_system_monitor" value="$(var launch_system_monitor)" />
    <arg name="launch_planning" value="$(var launch_planning)" />
    <arg name="launch_api" value="$(var launch_api)" />
    <arg name="rviz" value="$(var rviz)" />
    <arg name="rviz_respawn" value="$(var rviz_respawn)"/>

    <arg name="use_perception_detection" value="$(var use_perception_detection)"/>
    <arg name="use_traffic_light_recognition" value="$(var use_traffic_light_recognition)"/>
    <!-- <arg name="rviz_config" value="$(var scripts_root_path)/rviz/robobus.rviz"/> -->
  </include>
</launch>
