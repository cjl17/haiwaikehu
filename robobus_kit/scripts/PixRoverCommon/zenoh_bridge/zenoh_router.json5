{
  plugins: {
    ros2dds: {
      nodename: "zenoh_router",
      namespace: "/",
      allow: {
        publishers: [
          "/vehicle/status/gear_status",
          "/app/display/vehicle_info",
          "/app/display/all_station_info",
          "/app/display/current_station_info",
          "/app/cloud_control_platform/vehicle_info",
          "/app/cloud_control_platform/sensor_info",
          "/app/cloud_control_platform/autoware_info",
          "/planning/mission_planner/current_mission",
          "/api/motion/state",
          "/localization/kinematic_state",
          "/sensing/gnss/fix",
          "/sensing/gnss/heading",
          "/vehicle/status/control_mode",
          "/api/localization/initialization_state",
          "/sensing/gnss/gnss_fixed",
          "/system/operation_mode/state",
          "/api/autoware/get/emergency",
          "/planning/mission_planning/route",
          "/map/vector_map",
          "/api/operation_mode/state",
          "/api/routing/state",
          "/api/fail_safe/mrm_state",
          "/api/planning/velocity_factors",
          "/app/voice/remote_report",
          "/app/voice/display_report",
          "/planning/cooperate_status/avoidance_left",
          "/planning/cooperate_status/avoidance_right",
          "/planning/cooperate_status/lane_change_left",
          "/planning/cooperate_status/lane_change_right",
          "/app/display/voice_display_play_ctrl",
          "/api/motion/accept_start",
          "/app/app_control_topic",
          "/vehicle/status/steering_status",
          "/perception/traffic_light_recognition/traffic_signals",
          "/map/vector_map_marker",
          "/planning/scenario_planning/trajectory",
          "/planning/path_candidate/start_planner",
          "/planning/scenario_planning/lane_driving/behavior_planning/path",
          "/perception/object_recognition/objects",
          "/sensing/gnss/fix",
          "/localization/pose_estimator/transform_probability",
          "/pix_robobus/vcu_report1",
          "/pix_robobus/vehicle_mileage_fb",
          "/localization/pose_twist_fusion_filter/pose",
          "/pix_robobus/ac_message1",
          "/pix_robobus/ac_message2",
          "/pix_robobus/dp_messgae4",
          "/pix_robobus/dp_messgae5",
          "/pix_robobus/va_vehicle_work_sta_fb",
          "/pix/AebInfoReport",  
          "/pix_robobus/va_power_sta_fb",
          "/pix_robobus/va_brake_sta_fb",
          "/pix_robobus/va_drive_sta_fb",
          "/pix_robobus/va_vehicle_sta_fb",
          "/sensing/gnss/chc/pitch",
          "/control/current_gate_mode",
           "/autoware_orientation",
          "/pad/ai_voice_bot/broken_speak",
          "/pix/ai_voice_bot/stop_ai",
          "/pix/ai_voice_bot/voice_again",
          "/pixmoving_api/autoware_report",
          "/pixmoving/blind_spot/status",          
          "/pix_robobus/va_vehicle_flt_sta",          
          "/pix_robobus/vehicle_errcode1",          
          "/pix_robobus/vehicle_errcode2",          
          "/pix_robobus/historical_vehiclefailures1",          
          "/pix_robobus/bcm_message5",
          "/pix/ai_voice_bot/voice_again",
          "/pixmoving_api/autoware_report",
          // 20260815
          "/pixmoving_api/ads_audio/cmd",
          "/planning/teleop_takeover"
        ],
        subscribers: [
          "/planning/mission_planning/goal",
          "/autoware/engage",
          "/planning/scenario_planning/max_velocity_default",
          "/cloud_control_platform/v2d_all_station_info",
          "/pix_robobus/auto_vcu_message1",
          "/pix_robobus/auto_vcu_message2",
          "/api/motion/accept_start", 
          "/communication/alarm",
          "/communication/alarm_cnt",
          "/app/display/ai_request_info",
          "/time_stamp/PC",
          "/cpu/PC",
          "/control/gate_mode_cmd",
          "/external/selected/control_cmd",
          "/external/selected/gear_cmd",
          // "/external/selected/heartbeat",
          "/api/vehicle/whistle",
          "/api/operation_mode/change_to_remote",
          "/api/operation_mode/change_to_stop",
          "/remote/version",
          "/pixmoving_api/autoware_command",
          "/communication/alarm_info",
          // 20260815
          "/planning/teleop_active",
          "/planning/teleop_authorize_autonomous"
        ],
        // ---------------------------------
        service_servers: [
          "/api/autoware/set/emergency",
          "/api/vehicle/set/door",
          "/api/motion/accept_start",
          "/api/autoware/set/engage",
          "/control/vehicle_cmd_gate/external_emergency_stop",
          "/control/vehicle_cmd_gate/clear_external_emergency_stop",
          "/communication/alarm"
        ],
        service_clients: [
          "/cloud_control_platform/get_lenght/from_lanelet",
          "/script_executor/PC",
          "/communication/get_srv_alarmlist"
        ],
      }
    }
  },
  mode: "router",
  listen: {
    endpoints: ["tcp/192.168.3.103:7447"]  
  }
}
