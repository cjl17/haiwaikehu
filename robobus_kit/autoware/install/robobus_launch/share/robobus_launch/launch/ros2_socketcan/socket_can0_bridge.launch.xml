<launch>

  <let name="interface" value="can0" />
  <let name="receiver_interval_sec" value="0.03" />
  <let name="sender_timeout_sec" value="0.03" />

  <!-- can0 -->
  <include file="$(find-pkg-share robobus_launch)/launch/ros2_socketcan/socket_can0_receiver.launch.py">
    <arg name="interface" value="$(var interface)" />
    <arg name="interval_sec" value="$(var receiver_interval_sec)" />
  </include>

  <include file="$(find-pkg-share robobus_launch)/launch/ros2_socketcan/socket_can0_sender.launch.py">
    <arg name="interface" value="$(var interface)" />
    <arg name="timeout_sec" value="$(var sender_timeout_sec)" />
  </include>
</launch>
