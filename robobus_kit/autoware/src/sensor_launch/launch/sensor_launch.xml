<?xml version="1.0"?>
<launch>
  <!-- ========================================== -->
  <!-- 步骤0: 清理现有tmux会话,确保干净启动         -->
  <!-- ========================================== -->
  <executable 
    cmd="tmux kill-server 2>/dev/null || true" 
    name="kill_tmux_server" 
    output="screen"
    shell="true"
    launch-prefix=""
  />

  <log message="[INIT] 已执行 tmux kill-server,清理完毕"/>
  
  <!-- ========================================== -->
  <!-- 自动环境识别启动配置                        -->
  <!-- 通过 TMUX_NAME 环境变量自动选择启动组         -->
  <!-- export TMUX_NAME=ORIN1  # 优控域控          -->
  <!-- export TMUX_NAME=ORIN2  # IPC               -->
  <!-- ========================================== -->
  
  <!-- 读取环境变量 -->
  <arg name="tmux_name" default="$(env TMUX_NAME UNKNOWN)" description="当前设备标识: ORIN1(优控域控) 或 ORIN2(IPC)"/>
  <arg name="scripts_root" default="$(env SCRIPTS_ROOT /home/nvidia/pix/scripts)" description="脚本根目录"/>
  <arg name="gnss_receiver" default="chc" description="GNSS接收机类型: chc/novatel/ublox"/>
  
  <!-- 设备类型判断 -->
  <let name="is_orin1" value="$(eval &quot;'$(var tmux_name)' == 'ORIN1'&quot;)"/>
  <let name="is_orin2" value="$(eval &quot;'$(var tmux_name)' == 'ORIN2'&quot;)"/>
  
  <!-- 启动日志 -->
  <log message="==========================================================="/>
  <log message="Current Device: $(var tmux_name)"/>
  <log message="Scripts Root: $(var scripts_root)"/>
  <log message="ORIN1 (优控域控): $(var is_orin1)"/>
  <log message="ORIN2 (IPC): $(var is_orin2)"/>
  <log message="==========================================================="/>

  <!-- ========================================== -->
  <!-- ORIN1: 优控域控 - 电子后视镜                 -->
  <!-- ========================================== -->
  <group if="$(var is_orin1)">
    <log message="[ORIN1] 启动优控域控节点组..."/>
    
    <!-- 电子后视镜 (GStreamer Camera Pipeline) -->
    <include file="$(var scripts_root)/PixRoverCommon/electronic_rearview_mirror/gst_camera.launch.py"/>

    <log message="[ORIN1] 优控域控节点组启动完成"/>
  </group>

  <!-- ========================================== -->
  <!-- ORIN2: IPC - 组合导航, 底盘, 云控, 传感器    -->
  <!-- ========================================== -->
  <group if="$(var is_orin2)">
    <log message="[ORIN2] 启动IPC节点组..."/>
    
    <!-- 1. 组合导航 (CHC/ Novatel / Ublox) -->
    <include file="$(var scripts_root)/launch/combined_navigation.launch.xml">
      <arg name="gnss_receiver" value="$(var gnss_receiver)"/>
    </include>
    
    <!-- 2. 底盘驱动 + CAN驱动 + TF树发布 -->
    <include file="$(var scripts_root)/launch/vehicle_interface.launch.xml"/>
    
    
    <!-- 4. Zenoh桥接 - 转发档位给塞恩系统 -->
    <executable 
      cmd="$(var scripts_root)/PixRoverCommon/zenoh_bridge/zenoh_router.sh"
      name="zenoh_router" 
      output="screen"
      shell="true"
      respawn="true"
      respawn_delay="5.0"
      launch-prefix=""
    />
    
    <!-- 5. LiDAR驱动 (Robosense 速腾聚创) -->
    <include file="$(find-pkg-share robobus_sensor_kit_launch)/launch/lidar/lidar_robosense.launch.py"/>
    
    <!-- 6. 超声波雷达驱动 -->
    <include file="$(find-pkg-share sensor_launch)/launch/ultra_sonic_radar_driver.launch.xml"/>
    
    <log message="[ORIN2] IPC节点组启动完成"/>
  </group>

  <!-- 错误处理: TMUX_NAME 不匹配 -->
  <group unless="$(eval &quot;$(var is_orin1) or $(var is_orin2)&quot;)">
    <log message="[ERROR] 未知的 TMUX_NAME 值: '$(var tmux_name)'"/>
    <log message="[ERROR] 请设置环境变量: export TMUX_NAME=ORIN1 (优控域控) 或 export TMUX_NAME=ORIN2 (IPC)"/>
    <log message="[ERROR] 当前未启动任何节点"/>
  </group>

</launch>
